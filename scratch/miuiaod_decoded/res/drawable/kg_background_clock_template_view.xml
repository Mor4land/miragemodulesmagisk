<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape>
            <corners android:radius="@dimen/kg_clock_template_radius" />
            <stroke android:width="@dimen/kg_clock_template_border_width" android:color="@color/kg_blue" />
        </shape>
    </item>
    <item android:state_selected="false">
        <shape>
            <corners android:radius="@dimen/kg_clock_template_radius" />
        </shape>
    </item>
</selector>